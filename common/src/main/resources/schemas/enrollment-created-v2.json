{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tayjava.local/schemas/enrollment-created-v2.json",
  "title": "EnrollmentCreatedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "enrollmentId", "studentUsername", "courseId", "status", "occurredAt"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "enrollmentId": { "type": "integer", "minimum": 1 },
    "studentUsername": { "type": "string", "minLength": 1 },
    "courseId": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "studentEmail": { "type": ["string", "null"], "format": "email" }
  }
}
